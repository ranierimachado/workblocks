{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workblocks.local/contracts/plan-v1.schema.json",
  "title": "Workblocks plan import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "plan_name",
    "timezone",
    "effective_from",
    "default_block_minutes",
    "priorities",
    "standing_plan",
    "weeks"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "plan_name": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "default_block_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "standing_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 5000
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "slot",
              "priority_id"
            ],
            "properties": {
              "slot": {
                "enum": [
                  "morning",
                  "middle",
                  "evening",
                  "extra"
                ]
              },
              "priority_id": {
                "type": "string",
                "minLength": 1
              },
              "duration_minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 5000
              },
              "day": {
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              }
            }
          }
        }
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "week_start",
          "blocks"
        ],
        "properties": {
          "week_start": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "slot",
                "priority_id"
              ],
              "properties": {
                "slot": {
                  "enum": [
                    "morning",
                    "middle",
                    "evening",
                    "extra"
                  ]
                },
                "priority_id": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "notes": {
                  "type": "string",
                  "maxLength": 5000
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
